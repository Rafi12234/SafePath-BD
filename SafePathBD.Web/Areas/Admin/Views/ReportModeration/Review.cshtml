@model ModerationReviewViewModel
@{
    var m = Model.Report;
    var r = m.Report;
    var isAccident = r.ReportType == ReportTypes.Accident;
    ViewData["Title"] = "Review · " + r.Title;

    var accent = isAccident
        ? r.SeverityName switch
        {
            "Minor" => "var(--caution)",
            "Moderate" => "var(--warning)",
            "Severe" => "var(--danger)",
            "Fatal" => "var(--report-fatal)",
            _ => "var(--warning)"
        }
        : r.RiskLevel switch
        {
            "LOW" => "var(--safe)",
            "MODERATE" => "var(--caution)",
            "HIGH" => "var(--warning)",
            "CRITICAL" => "var(--danger)",
            _ => "var(--caution)"
        };

    var actions = new (string Status, string Label, string Variant, string Hint)[]
    {
        (ReportStatusCodes.UnderReview, "Start review", "neutral", "Claim this report while you look into it."),
        (ReportStatusCodes.Verified, "Verify", "positive", isAccident
            ? "Confirms the report and adds it to the trusted accident dataset."
            : "Confirms the report and makes it eligible for the public map."),
        (ReportStatusCodes.NeedsInfo, "Needs info", "caution", "Ask the reporter for more detail."),
        (ReportStatusCodes.Duplicate, "Duplicate", "warning", "The same issue is already reported."),
        (ReportStatusCodes.Rejected, "Reject", "danger", "The report cannot be substantiated."),
        (ReportStatusCodes.Resolved, "Resolve", "positive", "The issue is no longer active.")
    }.Where(a => m.AllowedTransitions.Contains(a.Status)).ToArray();

    var message = TempData["ModerationMessage"] as string;
    var variant = TempData["ModerationVariant"] as string ?? "info";
}

<section class="section section--tight">
    <div class="shell">
        <a class="back-link" asp-area="Admin" asp-controller="ReportModeration" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
            Back to the queue
        </a>
    </div>

    <div class="shell review-grid" style="--report-color: @accent">

        <div class="review-main">
            <header class="review-head">
                <div class="review-head-chips">
                    <partial name="_ReportStatusChip" model="@((r.StatusCode, r.StatusName))" />
                    <span class="chip chip--muted">@(isAccident ? "Accident" : "Hazard")</span>
                    @if (!r.IsPublic)
                    {
                        <span class="chip chip--muted">Private</span>
                    }
                    @if (m.PromotedAccidentId is not null)
                    {
                        <span class="chip chip--safe">In trusted dataset</span>
                    }
                </div>
                <h1 class="t-h2">@r.Title</h1>
                <p class="t-meta">@(r.AddressLine ?? r.AreaName ?? r.City ?? "Location recorded on the map")</p>
            </header>

            <div class="review-map-card panel">
                <div class="review-map" data-review-map
                     data-lat="@r.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-lng="@r.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-type="@r.ReportType"
                     data-accent="@accent"
                     role="img"
                     aria-label="Map showing where this report was made"></div>
                <div class="review-map-foot">
                    <span class="t-mono">@r.Latitude.ToString("F5"), @r.Longitude.ToString("F5")</span>
                    @if (!string.IsNullOrWhiteSpace(r.LandmarkName))
                    {
                        <span class="t-meta">Near @r.LandmarkName</span>
                    }
                </div>
            </div>

            @if (r.Images.Count > 0)
            {
                <section class="panel stack-4">
                    <h2 class="t-h3">Evidence</h2>
                    <div class="evidence-strip">
                        @foreach (var image in r.Images)
                        {
                            <a class="evidence-item" href="@Url.Action("Image", "Reports", new { area = "", id = image.ImageId })" target="_blank" rel="noopener">
                                <img src="@Url.Action("Image", "Reports", new { area = "", id = image.ImageId })"
                                     alt="@(image.Caption ?? "Photo submitted with this report")" loading="lazy" />
                            </a>
                        }
                    </div>
                    <p class="t-meta">Photos are served through an authorized endpoint and are not publicly reachable while this report is pending.</p>
                </section>
            }
            else
            {
                <div class="panel empty-inline">
                    <h2 class="t-h3">Evidence</h2>
                    <p class="t-meta">No photos were attached to this report.</p>
                </div>
            }

            <section class="panel stack-4">
                <h2 class="t-h3">What was reported</h2>
                @if (string.IsNullOrWhiteSpace(r.Description))
                {
                    <p class="t-meta">No description was provided.</p>
                }
                else
                {
                    <p class="t-body prewrap">@r.Description</p>
                }

                <dl class="detail-list">
                    @if (isAccident)
                    {
                        <div class="detail-row"><dt>Accident type</dt><dd>@(r.AccidentTypeName ?? "—")</dd></div>
                        <div class="detail-row"><dt>Severity</dt><dd>@(r.SeverityName ?? "—")</dd></div>
                        <div class="detail-row"><dt>Occurred at</dt><dd>@(r.AccidentOccurredAt?.ToString("d MMM yyyy, HH:mm") ?? "Not stated")</dd></div>
                        <div class="detail-row"><dt>Vehicles</dt><dd>@(r.NumberOfVehicles?.ToString() ?? "—")</dd></div>
                        <div class="detail-row"><dt>Injured</dt><dd>@(r.NumberOfInjured?.ToString() ?? "—")</dd></div>
                        <div class="detail-row"><dt>Lives lost</dt><dd>@(r.NumberOfDeaths?.ToString() ?? "—")</dd></div>
                        @if (!string.IsNullOrWhiteSpace(r.WeatherNotes))
                        {
                            <div class="detail-row"><dt>Conditions</dt><dd>@r.WeatherNotes</dd></div>
                        }
                    }
                    else
                    {
                        <div class="detail-row"><dt>Hazard type</dt><dd>@(r.HazardTypeName ?? "—")</dd></div>
                        <div class="detail-row"><dt>Risk level</dt><dd>@(r.RiskLevel ?? "—")</dd></div>
                        <div class="detail-row"><dt>Observed at</dt><dd>@(r.ObservedAt?.ToString("d MMM yyyy, HH:mm") ?? "Not stated")</dd></div>
                        @if (r.ExpectedClearanceAt is not null)
                        {
                            <div class="detail-row"><dt>Expected clearance</dt><dd>@r.ExpectedClearanceAt.Value.ToString("d MMM yyyy, HH:mm")</dd></div>
                        }
                    }
                    <div class="detail-row"><dt>Reported by</dt><dd>@(m.ReporterName ?? "Removed account")</dd></div>
                    <div class="detail-row"><dt>Reporter email</dt><dd>@(m.ReporterEmail ?? "—")</dd></div>
                    <div class="detail-row"><dt>Submitted</dt><dd>@r.ReportedAt.ToString("d MMM yyyy, HH:mm")</dd></div>
                </dl>
                <p class="t-micro t-muted">Reporter contact details are shown for moderation only and never appear on the public report page.</p>
            </section>

            <section class="panel stack-4">
                <h2 class="t-h3">Community discussion <span class="t-meta">@m.CommentCount</span></h2>
                @if (Model.Comments.TotalCount == 0)
                {
                    <p class="t-meta">No community discussion yet.</p>
                }
                else
                {
                    <ul class="comment-list">
                        @foreach (var c in Model.Comments.Items)
                        {
                            <li class="comment @(c.IsDeleted ? "is-removed" : null)">
                                <span class="comment-avatar" aria-hidden="true">@c.AuthorInitials</span>
                                <div class="comment-body">
                                    <div class="comment-head">
                                        <strong>@c.AuthorName</strong>
                                        @if (c.AuthorIsStaff)
                                        {
                                            <span class="chip chip--accent chip--plain">Moderator</span>
                                        }
                                        <time datetime="@c.CreatedAt.ToString("o")">@c.CreatedAt.ToString("d MMM, HH:mm")</time>
                                    </div>
                                    <p class="comment-text prewrap">@c.Text</p>
                                    @if (c.Replies.Count > 0)
                                    {
                                        <ul class="comment-replies">
                                            @foreach (var reply in c.Replies)
                                            {
                                                <li class="comment comment--reply @(reply.IsDeleted ? "is-removed" : null)">
                                                    <span class="comment-avatar" aria-hidden="true">@reply.AuthorInitials</span>
                                                    <div class="comment-body">
                                                        <div class="comment-head">
                                                            <strong>@reply.AuthorName</strong>
                                                            <time datetime="@reply.CreatedAt.ToString("o")">@reply.CreatedAt.ToString("d MMM, HH:mm")</time>
                                                        </div>
                                                        <p class="comment-text prewrap">@reply.Text</p>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <aside class="review-side">
            <div class="review-sticky stack-4">

                <div class="panel trust-panel">
                    <div class="trust-head">
                        <h2 class="t-h3">Community check</h2>
                        <span class="t-micro t-muted">Decision support only</span>
                    </div>
                    <div class="trust-bars">
                        <div class="trust-line">
                            <span class="trust-line-label"><span class="dot dot--confirm"></span> Confirm</span>
                            <span class="trust-line-value">@m.ConfirmCount</span>
                        </div>
                        <div class="trust-line">
                            <span class="trust-line-label"><span class="dot dot--dispute"></span> Dispute</span>
                            <span class="trust-line-value">@m.DisputeCount</span>
                        </div>
                    </div>
                    <p class="t-micro t-muted">Community agreement is not verification. Only a moderator decision changes a report's status.</p>
                </div>

                @if (actions.Length > 0)
                {
                    <div class="panel action-panel" data-decision-panel>
                        <h2 class="t-h3">Decision</h2>
                        <div class="action-stack">
                            @foreach (var a in actions)
                            {
                                <button type="button"
                                        class="action-btn action-btn--@a.Variant"
                                        data-decision="@a.Status"
                                        data-label="@a.Label"
                                        data-hint="@a.Hint"
                                        data-requires-note="@(ReportStatusTransitions.RequiresNote(a.Status).ToString().ToLowerInvariant())">
                                    <span class="action-btn-label">@a.Label</span>
                                    <span class="action-btn-hint">@a.Hint</span>
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="panel">
                        <h2 class="t-h3">Decision</h2>
                        <p class="t-meta">
                            This report is @r.StatusName.ToLowerInvariant() and no further status change is allowed.
                        </p>
                    </div>
                }

                <div class="panel stack-3">
                    <h2 class="t-h3">History</h2>
                    <ol class="timeline">
                        <li class="timeline-item is-done">
                            <span class="timeline-dot" aria-hidden="true"></span>
                            <div>
                                <strong>Reported</strong>
                                <p class="t-meta">@r.ReportedAt.ToString("d MMM yyyy, HH:mm")</p>
                            </div>
                        </li>
                        @foreach (var entry in m.History)
                        {
                            <li class="timeline-item is-done">
                                <span class="timeline-dot" aria-hidden="true"></span>
                                <div>
                                    <strong>@entry.StatusName</strong>
                                    <p class="t-meta">
                                        @(entry.ReviewerName ?? "Removed account") · @entry.VerifiedAt.ToString("d MMM yyyy, HH:mm")
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(entry.Note))
                                    {
                                        <p class="timeline-note prewrap">@entry.Note</p>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                    @if (m.History.Count == 0)
                    {
                        <p class="t-meta">No moderation decision has been recorded yet.</p>
                    }
                </div>

                <a class="btn btn-ghost btn-block" asp-area="" asp-controller="Reports" asp-action="Details" asp-route-id="@r.ReportId" target="_blank" rel="noopener">
                    Open the public view
                </a>
            </div>
        </aside>
    </div>
</section>

<!-- Decision confirmation, driven by the branded dialog rather than window.confirm(). -->
<div class="modal" data-decision-modal hidden>
    <div class="modal-scrim" data-decision-cancel></div>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="decision-title">
        <form method="post" asp-area="Admin" asp-controller="ReportModeration" asp-action="Decide" asp-route-id="@r.ReportId" data-decision-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="TargetStatus" data-decision-target />
            <input type="hidden" name="ExpectedStatus" value="@r.StatusCode" />

            <h2 class="t-h3" id="decision-title" data-decision-title>Confirm decision</h2>
            <p class="t-meta" data-decision-hint></p>

            <div class="modal-report">
                <span class="chip chip--muted">@(isAccident ? "Accident" : "Hazard")</span>
                <span>@r.Title</span>
            </div>

            <div class="field">
                <label class="field-label" for="decision-note">
                    Review note <span class="field-optional" data-note-optional>(optional)</span>
                </label>
                <textarea class="input" id="decision-note" name="Note" rows="3" maxlength="2000"
                          placeholder="Explain the decision for the record."></textarea>
                <p class="field-error" data-note-error hidden>A short explanation is required for this decision.</p>
            </div>

            <div class="modal-actions">
                <button class="btn btn-ghost" type="button" data-decision-cancel>Cancel</button>
                <button class="btn btn-primary" type="submit" data-decision-submit>Confirm</button>
            </div>
        </form>
    </div>
</div>

@section Head {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moderation.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/js/safepath-map.js" asp-append-version="true"></script>
    <script src="~/js/moderation.js" asp-append-version="true" defer></script>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.SafePathToast) {
                    window.SafePathToast.@(variant == "success" ? "success" : variant == "warning" ? "warning" : variant == "error" ? "error" : "info")(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(message)));
                }
            });
        </script>
    }
}
