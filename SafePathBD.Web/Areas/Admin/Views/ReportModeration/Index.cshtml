@model ModerationQueueViewModel
@{
    ViewData["Title"] = "Review queue";

    var f = Model.Filter;
    var counts = Model.Counts;

    var statusTabs = new (string? Code, string Label, int Count)[]
    {
        (ReportStatusCodes.Pending, "Pending", counts.Pending),
        (ReportStatusCodes.UnderReview, "Under review", counts.UnderReview),
        (ReportStatusCodes.NeedsInfo, "Needs info", counts.NeedsInfo),
        (ReportStatusCodes.Verified, "Verified", counts.Verified),
        (ReportStatusCodes.Rejected, "Rejected", counts.Rejected),
        (ReportStatusCodes.Duplicate, "Duplicate", counts.Duplicate),
        (ReportStatusCodes.Resolved, "Resolved", counts.Resolved),
        (null, "All", counts.Pending + counts.UnderReview + counts.NeedsInfo + counts.Verified + counts.Rejected + counts.Duplicate + counts.Resolved)
    };
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel
{
    Eyebrow = "Moderation",
    Title = "Report review queue",
    Description = "Community submissions waiting for a decision. Verification is what makes a report public.",
    Chips = new[] { new PageHeaderChip(counts.OpenTotal + " open", "chip--accent") }
})" />

<section class="section section--tight">
    <div class="shell mod-layout">

        <aside class="mod-filters" aria-label="Queue filters">
            <form method="get" asp-area="Admin" asp-controller="ReportModeration" asp-action="Index" class="stack-5" data-mod-filter>
                <div class="mod-filter-group">
                    <span class="mod-filter-label">Status</span>
                    <div class="mod-status-list">
                        @foreach (var tab in statusTabs)
                        {
                            var active = string.Equals(f.Status, tab.Code, StringComparison.Ordinal);
                            <a class="mod-status-item @(active ? "is-active" : null)"
                               asp-area="Admin" asp-controller="ReportModeration" asp-action="Index"
                               asp-route-status="@tab.Code"
                               asp-route-type="@f.Type"
                               asp-route-search="@f.Search">
                                <span>@tab.Label</span>
                                <span class="mod-status-count">@tab.Count</span>
                            </a>
                        }
                    </div>
                </div>

                <input type="hidden" name="status" value="@f.Status" />

                <div class="mod-filter-group">
                    <label class="mod-filter-label" for="type">Report type</label>
                    <select class="input" id="type" name="type">
                        <option value="">Accidents and hazards</option>
                        <option value="@ReportTypes.Accident" selected="@(f.Type == ReportTypes.Accident)">Accidents only</option>
                        <option value="@ReportTypes.Hazard" selected="@(f.Type == ReportTypes.Hazard)">Hazards only</option>
                    </select>
                </div>

                <div class="mod-filter-group">
                    <label class="mod-filter-label" for="severity">Accident severity</label>
                    <select class="input" id="severity" name="severity">
                        <option value="">Any severity</option>
                        @foreach (var s in new[] { "Minor", "Moderate", "Severe", "Fatal" })
                        {
                            <option value="@s" selected="@(f.Severity == s)">@s</option>
                        }
                    </select>
                </div>

                <div class="mod-filter-group">
                    <label class="mod-filter-label" for="risk">Hazard risk</label>
                    <select class="input" id="risk" name="risk">
                        <option value="">Any risk level</option>
                        @foreach (var r in HazardRiskLevels.All)
                        {
                            <option value="@r" selected="@(f.Risk == r)">@r.Substring(0, 1)@r.Substring(1).ToLowerInvariant()</option>
                        }
                    </select>
                </div>

                <div class="mod-filter-group">
                    <label class="mod-filter-label" for="search">Title or place</label>
                    <input class="input" id="search" name="search" value="@f.Search" placeholder="e.g. Mirpur Road" autocomplete="off" />
                </div>

                <div class="mod-filter-row">
                    <div class="mod-filter-group">
                        <label class="mod-filter-label" for="from">From</label>
                        <input class="input" id="from" name="from" type="date" value="@(f.From?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="mod-filter-group">
                        <label class="mod-filter-label" for="to">To</label>
                        <input class="input" id="to" name="to" type="date" value="@(f.To?.ToString("yyyy-MM-dd"))" />
                    </div>
                </div>

                <div class="mod-filter-actions">
                    <button class="btn btn-primary btn-block" type="submit">Apply filters</button>
                    @if (f.HasAnyFilter)
                    {
                        <a class="btn btn-ghost btn-block" asp-area="Admin" asp-controller="ReportModeration" asp-action="Index" asp-route-status="@f.Status">
                            Clear filters
                        </a>
                    }
                </div>
            </form>
        </aside>

        <div class="mod-queue">
            <div class="mod-queue-head">
                <h2 class="t-h3">@Model.Results.TotalCount report@(Model.Results.TotalCount == 1 ? "" : "s")</h2>
                @if (Model.Results.TotalPages > 1)
                {
                    <span class="t-meta">Page @Model.Results.Page of @Model.Results.TotalPages</span>
                }
            </div>

            @if (Model.Results.TotalCount == 0)
            {
                <div class="empty-state reveal">
                    <span class="card-icon card-icon--safe" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                    <h3 class="t-h3">@(f.HasAnyFilter ? "No reports match these filters." : "All caught up.")</h3>
                    <p class="t-body">
                        @(f.HasAnyFilter
                            ? "Try widening the date range or clearing a filter."
                            : "Nothing in this queue needs a decision right now.")
                    </p>
                    @if (f.HasAnyFilter)
                    {
                        <a class="btn btn-ghost" asp-area="Admin" asp-controller="ReportModeration" asp-action="Index" asp-route-status="@f.Status">Clear filters</a>
                    }
                </div>
            }
            else
            {
                <ul class="mod-list" data-mod-list>
                    @foreach (var item in Model.Results.Items)
                    {
                        var isAccident = item.ReportType == ReportTypes.Accident;
                        var accent = isAccident
                            ? item.SeverityName switch
                            {
                                "Minor" => "var(--caution)",
                                "Moderate" => "var(--warning)",
                                "Severe" => "var(--danger)",
                                "Fatal" => "var(--report-fatal)",
                                _ => "var(--warning)"
                            }
                            : item.RiskLevel switch
                            {
                                "LOW" => "var(--safe)",
                                "MODERATE" => "var(--caution)",
                                "HIGH" => "var(--warning)",
                                "CRITICAL" => "var(--danger)",
                                _ => "var(--caution)"
                            };

                        var subtype = isAccident
                            ? string.Join(" · ", new[] { item.AccidentTypeName, item.SeverityName }.Where(v => !string.IsNullOrWhiteSpace(v)))
                            : string.Join(" · ", new[] { item.HazardTypeName, item.RiskLevel }.Where(v => !string.IsNullOrWhiteSpace(v)));

                        var place = item.AreaName ?? item.City;
                        var age = (DateTime.Now - item.ReportedAt).TotalHours;
                        var when = age < 1 ? "Just now" : age < 24 ? $"{(int)age} h ago" : item.ReportedAt.ToString("d MMM yyyy");

                        <li class="mod-row reveal" style="--report-color: @accent">
                            <a class="mod-row-link" asp-area="Admin" asp-controller="ReportModeration" asp-action="Review" asp-route-id="@item.ReportId">
                                <span class="mod-row-type" aria-hidden="true">
                                    @if (isAccident)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M4 16.5V13l1.8-4.2A2 2 0 0 1 7.7 7.5h8.6a2 2 0 0 1 1.9 1.3L20 13v3.5" />
                                            <path d="M4 16.5h16M6.8 16.5v2M17.2 16.5v2M7.5 12.7h9" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 9.2v4M12 16.4h.01" />
                                            <path d="M10.3 4.4 2.6 17.6a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.4a2 2 0 0 0-3.4 0Z" />
                                        </svg>
                                    }
                                </span>

                                <span class="mod-row-main">
                                    <span class="mod-row-title">@item.Title</span>
                                    <span class="mod-row-meta">
                                        <span>@(isAccident ? "Accident" : "Hazard")</span>
                                        @if (!string.IsNullOrWhiteSpace(subtype))
                                        {
                                            <span>@subtype</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(place))
                                        {
                                            <span>@place</span>
                                        }
                                        <span>@when</span>
                                        @if (item.ImageCount > 0)
                                        {
                                            <span>@item.ImageCount photo@(item.ImageCount == 1 ? "" : "s")</span>
                                        }
                                        @if (!item.IsPublic)
                                        {
                                            <span>Private</span>
                                        }
                                    </span>
                                </span>

                                <span class="mod-row-trust" title="@item.ConfirmCount confirmed, @item.DisputeCount disputed">
                                    <span class="trust-pip trust-pip--confirm">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                                        @item.ConfirmCount
                                    </span>
                                    <span class="trust-pip trust-pip--dispute">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8.5v4.5M12 16.5h.01" /></svg>
                                        @item.DisputeCount
                                    </span>
                                </span>

                                <partial name="_ReportStatusChip" model="@((item.StatusCode, item.StatusName))" />
                            </a>
                        </li>
                    }
                </ul>

                @if (Model.Results.TotalPages > 1)
                {
                    <nav class="pager" aria-label="Queue pages">
                        @if (Model.Results.HasPrevious)
                        {
                            <a class="btn btn-ghost btn-sm"
                               asp-area="Admin" asp-controller="ReportModeration" asp-action="Index"
                               asp-route-status="@f.Status" asp-route-type="@f.Type" asp-route-severity="@f.Severity"
                               asp-route-risk="@f.Risk" asp-route-search="@f.Search" asp-route-page="@(Model.Results.Page - 1)">Previous</a>
                        }
                        <span class="t-meta">Page @Model.Results.Page of @Model.Results.TotalPages</span>
                        @if (Model.Results.HasNext)
                        {
                            <a class="btn btn-ghost btn-sm"
                               asp-area="Admin" asp-controller="ReportModeration" asp-action="Index"
                               asp-route-status="@f.Status" asp-route-type="@f.Type" asp-route-severity="@f.Severity"
                               asp-route-risk="@f.Risk" asp-route-search="@f.Search" asp-route-page="@(Model.Results.Page + 1)">Next</a>
                        }
                    </nav>
                }
            }
        </div>
    </div>
</section>

@section Head {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moderation.css" asp-append-version="true" />
}
