@model SafePathBD.Web.Models.ViewModels.Reports.CreateAccidentReportViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Report an accident";

    var pickerConfig = JsonSerializer.Serialize(new
    {
        lat = 23.8103,
        lng = 90.4125,
        zoom = 12,
        maxImages = Model.MaxImages,
        maxImageMb = Model.MaxImageMegabytes,
        allowedTypes = new[] { "image/jpeg", "image/png", "image/webp" }
    });

    var severityColor = new Dictionary<string, string>
    {
        ["Minor"] = "var(--caution)",
        ["Moderate"] = "var(--warning)",
        ["Severe"] = "var(--danger)",
        ["Fatal"] = "var(--report-fatal)"
    };
}

@section Head {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel
{
    Eyebrow = "Community reporting",
    Title = "Report an accident",
    Description = "Accident reports go to the moderation queue. Nothing you submit affects a road's safety score until it has been verified."
})" />

<section class="section section--tight">
    <div class="shell">
        <form method="post" enctype="multipart/form-data" asp-action="Accident" novalidate
              data-report-form="@pickerConfig">
            @Html.AntiForgeryToken()

            <div class="report-layout">
                @* ---------------------------------------------------------- map *@
                <div class="report-map-side" data-step-section="location">
                    <div class="picker">
                        <div class="picker-canvas" data-picker-canvas role="application" aria-label="Choose the accident location"></div>

                        <div class="picker-search">
                            <label class="visually-hidden" for="pickerSearch">Search for a place</label>
                            <input class="input" id="pickerSearch" type="text" placeholder="Search for a place"
                                   autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list"
                                   data-picker-search />
                            <div class="suggest" data-picker-suggest role="listbox" aria-label="Place suggestions"></div>
                        </div>

                        <button class="map-control picker-locate" type="button" data-picker-locate
                                title="Use my location" aria-label="Use my location">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="3.2" /><circle cx="12" cy="12" r="8" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3" />
                            </svg>
                        </button>
                    </div>

                    <div class="location-card" data-location-card>
                        <span class="t-eyebrow">Accident location</span>
                        <p class="t-body" data-location-summary style="margin-top: var(--space-2);">
                            Tap the map, search for a place, or use your location.
                        </p>
                        <p class="location-card-coords" data-location-coords></p>
                        <span class="field-error" data-location-error asp-validation-for="Location.Latitude"></span>
                    </div>

                    <input type="hidden" asp-for="Location.Latitude" data-field-lat />
                    <input type="hidden" asp-for="Location.Longitude" data-field-lng />
                    <input type="hidden" asp-for="Location.AddressLine" data-field-address />
                    <input type="hidden" asp-for="Location.LandmarkName" data-field-landmark />
                    <input type="hidden" asp-for="Location.AreaName" data-field-area />
                    <input type="hidden" asp-for="Location.City" data-field-city />
                    <input type="hidden" asp-for="Location.District" data-field-district />
                    <input type="hidden" asp-for="Location.Provider" data-field-provider />
                    <input type="hidden" asp-for="Location.ExternalPlaceId" data-field-external-place-id />
                </div>

                @* --------------------------------------------------------- form *@
                <div>
                    <nav class="stepper" aria-label="Report sections">
                        <button class="step-link is-active" type="button" data-step-link="location"><span>01</span> Location</button>
                        <button class="step-link" type="button" data-step-link="details"><span>02</span> Details</button>
                        <button class="step-link" type="button" data-step-link="impact"><span>03</span> Impact</button>
                        <button class="step-link" type="button" data-step-link="evidence"><span>04</span> Evidence</button>
                    </nav>

                    <div asp-validation-summary="ModelOnly" class="alert alert--error" role="alert"></div>

                    <section class="form-section" data-step-section="details">
                        <div class="form-section-head">
                            <span class="form-section-index">02</span>
                            <h2 class="t-h3">What happened</h2>
                        </div>

                        <div class="stack-4">
                            <div class="field">
                                <label class="field-label" asp-for="Title">Title</label>
                                <input class="input" asp-for="Title" placeholder="e.g. Two-car collision at the Mirpur Road junction" />
                                <span class="field-error" asp-validation-for="Title"></span>
                            </div>

                            <div class="field-grid">
                                <div class="field">
                                    <label class="field-label" asp-for="AccidentTypeId">Accident type</label>
                                    <select class="input" asp-for="AccidentTypeId">
                                        <option value="">Choose a type…</option>
                                        @foreach (var type in Model.AccidentTypes)
                                        {
                                            <option value="@type.Id">@type.Name</option>
                                        }
                                    </select>
                                    <span class="field-error" asp-validation-for="AccidentTypeId"></span>
                                </div>

                                <div class="field">
                                    <label class="field-label" asp-for="AccidentOccurredAt">When it happened</label>
                                    <input class="input" asp-for="AccidentOccurredAt" type="datetime-local" />
                                    <span class="field-error" asp-validation-for="AccidentOccurredAt"></span>
                                </div>
                            </div>

                            <div class="field">
                                <label class="field-label" asp-for="Description">Description</label>
                                <textarea class="input" asp-for="Description" rows="4"
                                          placeholder="Describe what you saw. Avoid naming individuals or sharing personal details."></textarea>
                                <span class="field-hint">Optional, but a clear description helps moderators review your report faster.</span>
                                <span class="field-error" asp-validation-for="Description"></span>
                            </div>
                        </div>
                    </section>

                    <section class="form-section" data-step-section="impact">
                        <div class="form-section-head">
                            <span class="form-section-index">03</span>
                            <h2 class="t-h3">Severity and impact</h2>
                        </div>

                        <div class="stack-5">
                            <div class="field">
                                <span class="field-label">How severe was it?</span>
                                <div class="choice-grid" role="radiogroup" aria-label="Accident severity">
                                    @foreach (var severity in Model.Severities)
                                    {
                                        var color = severityColor.TryGetValue(severity.Name, out var c) ? c : "var(--warning)";
                                        <label class="choice" style="--choice-color: @color">
                                            <input type="radio" asp-for="SeverityId" id="severity_@severity.Id" value="@severity.Id" />
                                            <span class="choice-body">
                                                <span class="choice-label">@severity.Name</span>
                                                @if (!string.IsNullOrWhiteSpace(severity.Description))
                                                {
                                                    <span class="choice-hint">@severity.Description</span>
                                                }
                                            </span>
                                        </label>
                                    }
                                </div>
                                <span class="field-error" asp-validation-for="SeverityId"></span>
                            </div>

                            <div class="field-grid field-grid--tight">
                                <div class="field">
                                    <label class="field-label" asp-for="NumberOfVehicles">Vehicles involved</label>
                                    <input class="input" asp-for="NumberOfVehicles" type="number" min="0" max="200" placeholder="Unknown" />
                                    <span class="field-error" asp-validation-for="NumberOfVehicles"></span>
                                </div>
                                <div class="field">
                                    <label class="field-label" asp-for="NumberOfInjured">People injured</label>
                                    <input class="input" asp-for="NumberOfInjured" type="number" min="0" max="500" />
                                    <span class="field-error" asp-validation-for="NumberOfInjured"></span>
                                </div>
                                <div class="field">
                                    <label class="field-label" asp-for="NumberOfDeaths">Lives lost</label>
                                    <input class="input" asp-for="NumberOfDeaths" type="number" min="0" max="500" />
                                    <span class="field-error" asp-validation-for="NumberOfDeaths"></span>
                                </div>
                            </div>

                            <div class="field">
                                <label class="field-label" asp-for="WeatherNotes">Weather and road conditions</label>
                                <input class="input" asp-for="WeatherNotes" placeholder="e.g. Heavy rain, standing water" />
                                <span class="field-error" asp-validation-for="WeatherNotes"></span>
                            </div>
                        </div>
                    </section>

                    <section class="form-section" data-step-section="evidence">
                        <div class="form-section-head">
                            <span class="form-section-index">04</span>
                            <h2 class="t-h3">Supporting photos</h2>
                        </div>

                        <div class="dropzone" data-dropzone tabindex="0" role="button"
                             aria-label="Add photos: click or drop files here">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 15V4m0 0L8 8m4-4 4 4" /><path d="M4 15v3.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V15" />
                            </svg>
                            <strong class="t-body">Click or drop photos here</strong>
                            <span class="t-meta">Up to @Model.MaxImages images · JPG, PNG or WebP · max @Model.MaxImageMegabytes MB each</span>
                        </div>

                        <input class="visually-hidden" type="file" asp-for="Images" multiple
                               accept="image/jpeg,image/png,image/webp" data-file-input />

                        <span class="field-error" asp-validation-for="Images"></span>

                        <div class="previews" data-previews aria-live="polite"></div>
                    </section>

                    <div class="submit-bar">
                        <p class="t-meta" style="margin: 0;">
                            Your report will be saved with the status <strong>Pending</strong> until a moderator reviews it.
                        </p>
                        <button class="btn btn-primary btn-lg" type="submit" data-submit>Submit report</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/safepath-map.js" asp-append-version="true"></script>
    <script src="~/js/report-form.js" asp-append-version="true"></script>
}
